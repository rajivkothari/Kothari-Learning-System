  "scaffoldingPolicies": [
    {
      "schemaVersion": 1,
      "id": "moves.on-a-line",
      "description": "Moves on a bounded line. Miss 1: the world shows the consequence. Then point at the givens (offered after 2 misses), the line as a number line (3), how to count (4), and a Concept Rescue with a parallel example (5). Every step can be asked for earlier. The answer itself is shown only as a last resort (7). A fresh item after 8.",
      "steps": [
        {
          "id": "point-at-givens",
          "kind": "highlightGiven",
          "assistance": "clue",
          "offer": "afterWrongTries",
          "afterWrongTries": 2
        },
        {
          "id": "number-line",
          "kind": "numberLine",
          "assistance": "visualSupport",
          "offer": "afterWrongTries",
          "afterWrongTries": 3
        },
        {
          "id": "count-strategy",
          "kind": "countStrategy",
          "assistance": "guided",
          "offer": "afterWrongTries",
          "afterWrongTries": 4
        },
        {
          "id": "show-answer",
          "kind": "showAnswer",
          "assistance": "demonstrated",
          "offer": "afterWrongTries",
          "afterWrongTries": 7
        }
      ],
      "allowLeaveAndReturn": true,
      "regenerateAfterWrongTries": 8,
      "conceptRescue": {
        "afterWrongTries": 5,
        "returnTo": "same"
      }
    },
    {
      "schemaVersion": 1,
