  "scaffoldingPolicies": [
    {
      "schemaVersion": 1,
      "id": "moves.on-a-line",
      "description": "Moves on a bounded line. Miss 1: the world shows the consequence, then a correction: the learner counts their own job through, step by step, and a fresh job of the same kind follows (the corrected one is recorded as missed, and help counts as guided on the fresh one). On the fresh job: point at the givens (offered after 2 misses), the line as a number line (3), how to count (4), the answer only as a last resort (7), another fresh job after 8. Every step can be asked for earlier.",
      "steps": [
        {
          "id": "point-at-givens",
          "kind": "highlightGiven",
          "assistance": "clue",
          "offer": "afterWrongTries",
          "afterWrongTries": 2
        },
        {
          "id": "number-line",
          "kind": "numberLine",
          "assistance": "visualSupport",
          "offer": "afterWrongTries",
          "afterWrongTries": 3
        },
        {
          "id": "count-strategy",
          "kind": "countStrategy",
          "assistance": "guided",
          "offer": "afterWrongTries",
          "afterWrongTries": 4
        },
        {
          "id": "show-answer",
          "kind": "showAnswer",
          "assistance": "demonstrated",
          "offer": "afterWrongTries",
          "afterWrongTries": 7
        }
      ],
      "allowLeaveAndReturn": true,
      "regenerateAfterWrongTries": 8,
      "conceptRescue": {
        "afterWrongTries": 1,
        "returnTo": "fresh",
        "example": "target"
      }
    },
    {
      "schemaVersion": 1,
      "id": "encounter.clues-only",
      "description": "Mastery Encounter: point at the givens, then the load meter or line. A Concept Rescue after 5 misses. Never shows the answer.",
      "steps": [
        {
          "id": "point-at-givens",
          "kind": "highlightGiven",
          "assistance": "clue",
          "offer": "onRequest"
        },
        {
          "id": "number-line",
          "kind": "numberLine",
          "assistance": "visualSupport",
          "offer": "onRequest"
        }
      ],
      "allowLeaveAndReturn": true,
      "conceptRescue": {
        "afterWrongTries": 5,
        "returnTo": "same"
      }
    },
    {
      "schemaVersion": 1,
      "id": "loads.counted",
      "description": "Putting groups together, counted as objects. Miss 1: the world shows the consequence, then a correction: the learner counts their own load through, and a fresh job of the same kind follows. On the fresh job: point at the givens (offered after 2 misses), the load meter (3), how to count (4), the answer only as a last resort (7), another fresh job after 8.",
      "steps": [
        {
          "id": "point-at-givens",
