{
  "name": "kothari-learning-system",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lab:android:release": "node scripts/run-with-env.js EXPO_PUBLIC_DEVICE_LAB=1 -- expo run:android --variant release",
    "lab:ios:release": "node scripts/run-with-env.js EXPO_PUBLIC_DEVICE_LAB=1 -- expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check:fire": "node scripts/check-fire-compat.js",
    "doctor": "npx expo-doctor@latest",
    "verify": "npm run typecheck && npm run lint && npm test -- --ci && npm run check:fire",
    "test:engine": "jest --selectProjects engine",
    "validate:content": "node scripts/run-with-env.js CONTENT_BUDGET=ci -- jest src/engine/validation/samplePack.test.ts src/themes/content src/themes/catalog src/themes/elevator-quest/art --selectProjects engine theme",
    "bench": "node scripts/run-with-env.js BENCH=1 -- jest --selectProjects bench --verbose=false",
    "validate:content:release": "node scripts/run-with-env.js CONTENT_BUDGET=release -- jest src/engine/validation/samplePack.test.ts src/themes/content src/themes/catalog src/themes/elevator-quest/art --selectProjects engine theme",
    "web:prepare": "node scripts/prepare-web.js",
    "web:playtest": "node scripts/web.js playtest",
    "web:export": "node scripts/web.js export",
    "web:serve": "node scripts/serve-web.js dist-web",
    "web:screenshots": "node scripts/web-screenshots.js",
    "web:e2e": "node scripts/web-e2e.js",
    "check:bundle": "node scripts/check-bundle.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "sql.js": "^1.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "fast-check": "^4.10.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3"
  }
}
