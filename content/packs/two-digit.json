  "misconceptions": [
    {
      "id": "quantity.forgotTheCarry",
      "domain": "math",
      "description": "Added the ones into a new ten, then left that ten out (10 short)."
    },
    {
      "id": "quantity.smallerFromLarger",
      "domain": "math",
      "description": "Took the smaller digit from the larger in each column instead of breaking a ten (52 - 27 gives 35)."
    },
    {
      "id": "quantity.forgotTheBorrow",
      "domain": "math",
      "description": "Broke a ten into ones but still counted that ten (10 over)."
    },
    {
      "id": "quantity.addedInsteadOfSubtracted",
      "domain": "math",
      "description": "Put the numbers together where one comes out of the other."
    },
    {
      "id": "quantity.subtractedInsteadOfAdded",
      "domain": "math",
      "description": "Took one number from the other where both go together."
    },
    {
      "id": "quantity.answeredWithAGiven",
      "domain": "math",
      "description": "Answered with one of the numbers already given."
    },
    {
      "id": "quantity.miscountedTens",
