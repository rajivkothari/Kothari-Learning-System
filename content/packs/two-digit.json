  "scaffoldingPolicies": [
    {
      "schemaVersion": 1,
      "id": "cargo.tens-and-ones",
      "description": "Two-digit loads. Help teaches: TENS AND ONES (split the numbers into tens and ones, visual support) can be asked for at any time and is offered after the first miss; then a jump strategy on a number line (by tens, then ones; guided), offered after 2 misses; then SHOW ME (the answer shown, demonstrated), offered after 3 misses once both hints are used. A fourth miss brings a fresh load. A theme's scratch tools are not help: they are part of the screen. No Concept Rescue.",
      "steps": [
        {
          "id": "tens-and-ones",
          "kind": "tensAndOnes",
          "assistance": "visualSupport",
          "offer": "afterWrongTries",
          "afterWrongTries": 1
        },
        {
          "id": "jump-strategy",
          "kind": "jumpStrategy",
          "assistance": "guided",
          "offer": "afterWrongTries",
          "afterWrongTries": 2
        },
        {
