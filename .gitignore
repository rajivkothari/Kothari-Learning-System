# Private learner data. Never commit real names, diagnoses, or family details.
# Only the README and *.example.* templates in private/ are tracked.
private/*
!private/README.md
!private/*.example.*

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by `expo prebuild`, Continuous Native Generation)
/ios
/android

# Build artifacts
*.apk
*.aab
*.ipa
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Env
.env*.local

# OS / editor
.DS_Store
*.pem

# TypeScript
*.tsbuildinfo

# Test output
coverage/

# Android build cache
.kotlin/

# Web build (scripts/prepare-web.js copies installed wasm here; export output)
/public/
/dist-web/
/web-screenshots/

# AI review bundles (scripts/build-review-bundle.mjs): generated on demand, never committed
/.ai-review/

# Claude Code personal permissions (never tracked; the shared .claude/settings.json stays least-privilege, D171, D181)
.claude/settings.local.json
