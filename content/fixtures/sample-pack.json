  "scaffoldingPolicies": [
    {
      "schemaVersion": 1,
      "id": "arithmetic.default",
      "description": "Arithmetic: nudge, then a different representation, then guided steps. Answer shown only on request after three misses.",
      "steps": [
        { "id": "highlight-start", "kind": "highlightGiven", "assistance": "clue", "offer": "onRequest" },
        { "id": "number-line", "kind": "alternateRepresentation", "assistance": "visualSupport", "offer": "afterWrongTries", "afterWrongTries": 2 },
        { "id": "step-through", "kind": "guidedSteps", "assistance": "guided", "offer": "onRequest" },
        { "id": "show-answer", "kind": "showAnswer", "assistance": "demonstrated", "offer": "afterWrongTries", "afterWrongTries": 3 }
      ],
      "allowLeaveAndReturn": true,
      "regenerateAfterWrongTries": 4
    },
    {
      "schemaVersion": 1,
      "id": "literacy.phonics",
      "description": "Phonics: hear the word again, then a mouth-shape picture, then the answer.",
      "steps": [
        { "id": "replay-word", "kind": "replayWord", "assistance": "verbalHint", "offer": "onRequest" },
        { "id": "mouth-picture", "kind": "articulationPicture", "assistance": "visualSupport", "offer": "afterWrongTries", "afterWrongTries": 1 },
        { "id": "show-answer", "kind": "showAnswer", "assistance": "demonstrated", "offer": "afterWrongTries", "afterWrongTries": 2 }
      ],
      "allowLeaveAndReturn": true
    },
    {
      "schemaVersion": 1,
      "id": "encounter.no-demonstration",
      "description": "Mastery Encounter: clues only. No demonstrated answers; leaving and returning later is the release valve.",
      "steps": [{ "id": "remind-notes", "kind": "pointToWorldInfo", "assistance": "clue", "offer": "onRequest" }],
      "allowLeaveAndReturn": true
    }
  ],
