  "skills": [
    {
      "id": "ela.comprehension.keyDetails",
      "domain": "literacy",
      "strand": "comprehension",
      "label": "Read a short text and act on its key details",
      "gradeBand": [
        1,
        2
      ],
      "representations": [
        "sceneObject",
        "numeral"
      ]
    },
    {
      "id": "ela.comprehension.inference",
      "domain": "literacy",
      "strand": "comprehension",
      "label": "Work out what a short text means but does not say, from its clues",
      "gradeBand": [
        2,
        3
      ],
      "representations": [
        "sceneObject",
        "numeral"
      ]
    },
    {
      "id": "ela.comprehension.sequence",
      "domain": "literacy",
      "strand": "comprehension",
      "label": "Follow the order of steps in a short text (first, before, after)",
      "gradeBand": [
        1,
        2
      ],
      "representations": [
        "sceneObject",
        "numeral"
      ]
    },
    {
      "id": "ela.vocabulary.context",
      "domain": "literacy",
      "strand": "vocabulary",
      "label": "Work out a word's meaning from the sentences around it",
      "gradeBand": [
        1,
        2
      ],
      "representations": [
        "sceneObject",
        "textCards"
      ]
    },
    {
      "id": "ela.comprehension.causeEffect",
      "domain": "literacy",
      "strand": "comprehension",
      "label": "Tell what caused an event in a short text",
      "gradeBand": [
        2,
        3
      ],
      "representations": [
        "sceneObject"
      ]
    },
    {
      "id": "ela.language.sentences",
      "domain": "literacy",
      "strand": "language",
      "label": "Tell a whole sentence and a question, and what a word like \"it\" points back to",
      "gradeBand": [
        1,
        2
      ],
      "representations": [
        "textCards"
      ]
    }
  ],
  "misconceptions": [
    {
      "id": "reading.ignoredNegation",
      "domain": "literacy",
      "description": "Missed a \"not\": did the thing the text rules out."
    },
    {
      "id": "reading.choseFirstNamed",
      "domain": "literacy",
      "description": "Chose the first thing the text names, not the one it asks for."
    },
    {
      "id": "reading.choseLastNamed",
      "domain": "literacy",
      "description": "Chose the last thing named before the question or the word \"it\", not the one the text means."
    },
    {
      "id": "reading.wrongDirection",
      "domain": "literacy",
      "description": "Went the opposite way from the direction word (above for below, or the reverse)."
    },
    {
      "id": "reading.wentToOtherPlace",
      "domain": "literacy",
      "description": "Went to another place the text names (where a message came from, or the landmark a direction starts from)."
    },
    {
      "id": "reading.usedNumberAsAnswer",
      "domain": "literacy",
      "description": "Answered with a number from the text instead of using it (\"two above\" answered as 2)."
    },
    {
      "id": "reading.followedWordOrder",
      "domain": "literacy",
      "description": "Took the steps in the order they are written when \"before\" or \"after\" gives another order."
    },
    {
      "id": "reading.mixedUpSides",
      "domain": "literacy",
      "description": "Mixed up left and right."
    },
    {
      "id": "reading.otherWordMeaning",
      "domain": "literacy",
      "description": "Chose another meaning of the word, one that does not fit this sentence."
    },
    {
      "id": "reading.swappedCauseAndEffect",
      "domain": "literacy",
      "description": "Chose what happened (the effect) when the text asks what made it happen (the cause)."
    },
    {
      "id": "reading.matchedWordsOnly",
      "domain": "literacy",
      "description": "Chose an answer that shares words with the text but is not what the text says."
    }
  ],
  "scaffoldingPolicies": [
    {
      "schemaVersion": 1,
      "id": "reading.text-clue",
      "description": "Reading: the text is the help. CLUE lights up the key sentence: it can be asked for at any time and is offered after the first miss (with a cue for the likely misreading when the miss has one). Once CLUE has been used after a miss, SHOW ME is offered: the answer is shown (demonstrated, no credit). A second miss brings a fresh item instead of a third try, so three options cannot be cleared by elimination. No Concept Rescue: there is nothing to count.",
      "steps": [
        {
          "id": "key-sentence",
          "kind": "highlightGiven",
          "assistance": "clue",
          "offer": "afterWrongTries",
          "afterWrongTries": 1
        },
        {
          "id": "show-answer",
          "kind": "showAnswer",
          "assistance": "demonstrated",
          "offer": "afterWrongTries",
          "afterWrongTries": 1
        }
      ],
      "allowLeaveAndReturn": true,
      "regenerateAfterWrongTries": 2
    }
  ],
