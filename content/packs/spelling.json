  "misconceptions": [
    {
      "id": "spelling.shortVowel",
      "domain": "literacy",
      "description": "Wrote a different short vowel (cob for cab)."
    },
    {
      "id": "spelling.silentE",
      "domain": "literacy",
      "description": "Left out a silent e that makes the vowel long, or added one that does not belong."
    },
    {
      "id": "spelling.vowelTeam",
      "domain": "literacy",
      "description": "Wrote one vowel, or the wrong pair, where two vowels make one sound (ran for rain)."
    },
    {
      "id": "spelling.blend",
      "domain": "literacy",
      "description": "Left out one sound of a consonant blend (sop for stop)."
    },
    {
      "id": "spelling.digraph",
      "domain": "literacy",
      "description": "Split or dropped a two-letter sound (sip for ship, lok for lock)."
    },
    {
      "id": "spelling.doubleLetter",
      "domain": "literacy",
      "description": "One letter where the word doubles it, or a double where it does not."
    },
    {
      "id": "spelling.silentLetter",
      "domain": "literacy",
      "description": "Left out a letter that makes no sound (rench for wrench, lite for light)."
    },
    {
      "id": "spelling.letterOrder",
      "domain": "literacy",
      "description": "The right letters in the wrong order (gaet for gate)."
    },
    {
      "id": "spelling.ending",
      "domain": "literacy",
      "description": "Spelled an unstressed ending by its sound (cabel for cable, moter for motor)."
    }
  ],
  "scaffoldingPolicies": [
    {
      "schemaVersion": 1,
      "id": "spelling.word-clues",
      "description": "Spelling from letter tiles. Hearing the word again is not help (no step: the game replays its narration). SOUND HINT (a sound or syllable hint, clue) can be asked for at any time and is offered after the first miss; then a part of the word (the spelling pattern's letters placed in their slots, guided), offered after 2 misses; then SHOW ME (the word shown, demonstrated), offered after 3 misses once the hints are used. A fourth miss brings a fresh word. No Concept Rescue.",
      "steps": [
        {
          "id": "sound-hint",
          "kind": "phonicsHint",
          "assistance": "clue",
          "offer": "afterWrongTries",
          "afterWrongTries": 1
        },
        {
          "id": "show-part",
          "kind": "revealPattern",
          "assistance": "guided",
          "offer": "afterWrongTries",
          "afterWrongTries": 2
        },
        {
          "id": "show-word",
          "kind": "showAnswer",
          "assistance": "demonstrated",
          "offer": "afterWrongTries",
          "afterWrongTries": 3
        }
      ],
      "allowLeaveAndReturn": true,
      "regenerateAfterWrongTries": 4
    }
  ],
