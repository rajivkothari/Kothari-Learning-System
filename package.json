{
  "name": "kothari-learning-system",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lab:android:release": "EXPO_PUBLIC_DEVICE_LAB=1 expo run:android --variant release",
    "lab:ios:release": "EXPO_PUBLIC_DEVICE_LAB=1 expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check:fire": "node scripts/check-fire-compat.js",
    "doctor": "npx expo-doctor@latest",
    "verify": "npm run typecheck && npm run lint && npm test -- --ci && npm run check:fire"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "resolver": "<rootDir>/jest.resolver.js"
  }
}
