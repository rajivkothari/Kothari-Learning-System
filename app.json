{
  "expo": {
    "name": "Kothari Learning",
    "slug": "kothari-learning-system",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.kotharifamily.learning"
    },
    "android": {
      "package": "com.kotharifamily.learning",
      "adaptiveIcon": {
        "backgroundColor": "#0E1726",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Andika",
                "fontDefinitions": [
                  {
                    "path": "./assets/themes/magical-kingdom/fonts/Andika-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/themes/magical-kingdom/fonts/Andika-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/themes/magical-kingdom/fonts/Andika-Regular.ttf",
              "./assets/themes/magical-kingdom/fonts/Andika-Bold.ttf"
            ]
          }
        }
      ]
    ]
  }
}
